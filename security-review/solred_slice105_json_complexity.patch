+# Bound the parsed JSON shape before deepcopy, hashing, or native UI rendering.
+# This is deliberately iterative: a valid deeply nested JSON value must not
+# cause RecursionError in a request handler or trusted native approval issuer.
+MAX_REQUEST_DEPTH = 64
+MAX_REQUEST_NODES = 8192
+MAX_REQUEST_TEXT_BYTES = 1024 * 1024
+
+
+def _validate_json_shape(value):
+    pending = [(value, 0)]
+    nodes = 0
+    text_bytes = 0
+    while pending:
+        item, depth = pending.pop()
+        nodes += 1
+        if nodes > MAX_REQUEST_NODES or depth > MAX_REQUEST_DEPTH:
+            raise ValueError("request JSON complexity limit")
+        if isinstance(item, dict):
+            for key, child in item.items():
+                if not isinstance(key, str):
+                    raise ValueError("JSON object keys must be strings")
+                text_bytes += len(key.encode("utf-8"))
+                if text_bytes > MAX_REQUEST_TEXT_BYTES:
+                    raise ValueError("request JSON text limit")
+                pending.append((child, depth + 1))
+        elif isinstance(item, list):
+            pending.extend((child, depth + 1) for child in item)
+        elif isinstance(item, str):
+            text_bytes += len(item.encode("utf-8"))
+            if text_bytes > MAX_REQUEST_TEXT_BYTES:
+                raise ValueError("request JSON text limit")
+        elif item is None or isinstance(item, (bool, int)):
+            pass
+        elif isinstance(item, float):
+            if not math.isfinite(item):
+                raise ValueError("non-finite JSON number")
+        else:
+            raise ValueError("unsupported JSON value")
+
