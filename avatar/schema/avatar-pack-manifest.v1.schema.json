{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selma.local/schemas/avatar-pack-manifest.v1.schema.json",
  "title": "Selma Avatar Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "pack_id", "pack_version", "personification_id", "states", "chunks", "signature"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract": {"const": "selma.avatar-pack.v1"},
    "pack_id": {"type": "string", "pattern": "^avatar-pack:[a-z0-9][a-z0-9._-]*$"},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "personification_id": {"type": "string", "pattern": "^personification:[a-z0-9][a-z0-9._-]*$"},
    "states": {"type": "array", "uniqueItems": true, "minItems": 7, "maxItems": 7, "items": {"enum": ["IDLE", "LISTENING", "THINKING", "SPEAKING", "INTERRUPTED", "SLEEPING", "ERROR"]}},
    "chunks": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/chunk"}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value_base64"], "properties": {"algorithm": {"type": "string"}, "key_id": {"type": "string"}, "value_base64": {"type": "string", "contentEncoding": "base64"}}}
  },
  "$defs": {"chunk": {"type": "object", "additionalProperties": false, "required": ["chunk_id", "path", "encoding", "encoded_size", "decoded_size", "sha256"], "properties": {"chunk_id": {"type": "string"}, "path": {"type": "string"}, "encoding": {"enum": ["stored", "zlib"]}, "encoded_size": {"type": "integer", "minimum": 0}, "decoded_size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
