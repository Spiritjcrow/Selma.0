{
  "name": "replika_migration_v1",
  "version": "1.1.1",
  "description": "Import user-authorized Replika exports into Selma memory with provenance, deduplication, local SSH/stdin stream staging, and no private-endpoint scraping.",
  "provider": "replika",
  "capabilities": [
    "preview_local_archive",
    "import_local_archive",
    "receive_authorized_ssh_stdin_stream",
    "stage_stream_with_sha256_and_mode_0600",
    "preserve_backstory_memories_traits_interests_chat",
    "record_source_provenance"
  ],
  "network_access": false,
  "private_endpoint_scraping": false,
  "credential_collection": false,
  "supported_inputs": ["json", "jsonl", "csv", "txt"],
  "stream_transport": {
    "mode": "external_ssh_or_stdin",
    "bridge_opens_network_connections": false,
    "default_action": "preview",
    "import_requires_explicit_confirmation": true,
    "max_default_bytes": 268435456
  },
  "tools": [
    {
      "name": "replika.preview_archive",
      "risk": "read",
      "requires_approval": false
    },
    {
      "name": "replika.import_archive",
      "risk": "write",
      "requires_approval": true
    }
  ]
}
