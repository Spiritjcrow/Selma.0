<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Narrow package visibility: discover only apps with launchable activities. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Selma"
        android:icon="@drawable/ic_selma"
        android:roundIcon="@drawable/ic_selma"
        android:theme="@style/Theme.Selma"
        android:usesCleartextTraffic="false">
        <!-- Existing remote companion remains available as before. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explicit opt-in HOME, no automatic default-laucher enrollment. -->
        <activity android:name=".LauncherActivity" android:exported="true"
                  android:label="SelmaOS Home"
                  android:icon="@drawable/ic_selma_home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
